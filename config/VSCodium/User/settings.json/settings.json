{
  "workbench.browser.showInTitleBar": false,
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "window.commandCenter": false,
  "editor.formatOnSave": true,
  "files.autoSave": "afterDelay",
  "window.menuBarVisibility": "toggle",
  "workbench.notifications.showInTitleBar": false,
  "window.titleBarStyle": "native",
  "workbench.startupEditor": "none",
  "window.restoreWindows": "none",
  "editor.wordWrap": "wordWrapColumn",
  "workbench.productIconTheme": "material-product-icons",
  "editor.fontFamily": "'JetBrainsMono Nerd Font Propo', 'JetBrainsMonoNL Nerd Font Propo', monospace",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.padding.bottom": 15,
  "editor.padding.top": 15,
  "editor.inlayHints.padding": true,
  "breadcrumbs.enabled": false,
  "editor.minimap.enabled": false,
  "workbench.statusBar.visible": false,
  "workbench.sideBar.experimental.fontSize": 14,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.editorAssociations": {
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
    "*.qrc": "qt-core.qrcEditor",
  },
  "qt-core.additionalQtPaths": [
    {
      "name": "Qt-5.15.19-linux-g++-x86_64_from_PATH",
      "path": "/usr/bin/qtpaths",
    },
  ],
  "qt-qml.qmlls.useQmlImportPathEnvVar": true,
  "workbench.editor.showTabs": "single",
  "editor.fontSize": 15,
  "editor.fontWeight": "500",
  "editor.fontLigatures": true,
  "workbench.fontAliasing": "antialiased",
  "qt-core.showWelcomePageOnActivation": false,
  "workbench.editor.enablePreview": false,
  "explorer.confirmDelete": false,
  // Dynamic colors are supplied by the Matugen Colorful theme extension.
  "workbench.colorTheme": "Matugen Colorful",
  "explorer.confirmDragAndDrop": false,
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://raw.githubusercontent.com": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true,
  },
  "git.autofetch": true,
  "redhat.telemetry.enabled": true,
}
