// Zed Settings Configuration
// C:/Users/bryan/AppData/Roaming/Zed/settings.json
{
  // General & System
  "agent_buffer_font_family": "JetBrainsMonoNL Nerd Font Propo",
  "agent_ui_font_family": "JetBrainsMono Nerd Font Propo",
  "markdown_preview": {
    "font_size": 15.0
  },
  "cursor_animation": {
    "enabled": true
  },
  "reduce_motion": "on",
  "disable_ai": true,
  "format_on_save": "on",
  "cli_default_open_behavior": "existing_window",
  "language_models": {
    "opencode": {
      "show_zen_models": false,
      "show_go_models": false,
    },
    "openai_compatible": {},
    "vercel_ai_gateway": {
      "api_url": "https://ai-gateway.vercel.sh/coding-agent/v1",
      "available_models": [
        {
          "name": "anthropic/claude-opus-4.8",
          "display_name": "Claude Opus 4.8",
          "max_tokens": 1000000,
          "max_output_tokens": 128000,
          "capabilities": {
            "tools": true,
            "images": true,
            "prompt_cache_key": true,
            "parallel_tool_calls": true,
          },
        },
      ],
    },
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "agent": {
    "sidebar_side": "right",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^git\\b",
            },
            {
              "pattern": "^pnpm\\s+typecheck(\\s|$)",
            },
            {
              "pattern": "^pnpm\\s+test(\\s|$)",
            },
            {
              "pattern": "^pnpm\\s+lint(\\s|$)",
            },
          ],
        },
      },
    },
    "default_model": {
      "effort": "max",
      "provider": "openai",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "proxy": "",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "restore_on_startup": "launchpad",
  "auto_update_extensions": {
    "opencode": true,
  },
  "session": {
    "trust_all_worktrees": true,
    "restore_unsaved_buffers": false,
  },
  "redact_private_values": false,
  "use_system_window_tabs": false,
  "base_keymap": "VSCode",

  // Appearance & Theme
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Modest Dark",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Colored Zed Icons Theme Light",
    "dark": "Material Icon Theme",
  },
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "ui_font_size": 15.5,
  "ui_font_weight": 370.0,
  "centered_layout": {
    "left_padding": 0.15,
    "right_padding": 0.15,
  },
  "bottom_dock_layout": "full",
  "active_pane_modifiers": {
    "border_size": 0.0,
  },
  "theme_overrides": {
    "Modest Dark": {
      "editor.document_highlight.read_background": "#00000000",
      "editor.document_highlight.write_background": "#00000000",
    },
  },

  // Editor Font & Layout
  "buffer_font_family": "JetBrainsMonoNL Nerd Font",
  "buffer_font_size": 15,
  "buffer_font_weight": 400.0,
  "buffer_font_fallbacks": ["CaskaydiaCove Nerd Font Mono"],
  "buffer_font_features": {
    "liga": true,
    "calt": true,
  },
  "buffer_line_height": "standard",
  "soft_wrap": "bounded",
  "preferred_line_length": 210,
  "max_tabs": 2,
  "tab_bar": {
    "show": true,
  },
  "tabs": {
    "show_diagnostics": "all",
    "show_close_button": "always",
    "file_icons": true,
    "close_position": "right",
    "git_status": true,
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "gutter": {
    "line_numbers": true,
    "min_line_number_digits": 0,
    "folds": true,
    "runnables": false,
    "breakpoints": false,
  },
  "relative_line_numbers": "disabled",
  "minimap": {
    "show": "never",
  },
  "scrollbar": {
    "show": "always",
    "cursors": true,
    "git_diff": true,
    "search_results": true,
    "selected_text": true,
    "selected_symbol": true,
    "diagnostics": "all",
    "axes": {
      "horizontal": false,
      "vertical": true,
    },
  },
  "indent_guides": {
    "coloring": "fixed",
    "enabled": false,
  },
  "show_whitespaces": "none",
  "colorize_brackets": true,

  // Editor Behavior
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },

  "auto_indent_on_paste": true,
  "cursor_blink": false,
  "cursor_shape": "bar",
  "current_line_highlight": "none",
  "selection_highlight": false,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "seed_search_query_from_cursor": "never",
  "show_completion_documentation": true,
  "hover_popover_enabled": true,
  "show_completions_on_input": true,
  "diagnostics_max_severity": "all",
  "when_closing_with_no_tabs": "keep_window_open",
  "close_on_file_delete": true,
  "extend_comment_on_newline": false,
  "restore_on_file_reopen": false,

  // Panels & Navigation
  "project_panel": {
    "dock": "left",
    "hide_root": false,
    "auto_fold_dirs": false,
    "starts_open": false,
    "git_status": true,
    "scrollbar": {
      "show": "never",
    },
    "sticky_scroll": false,
    "indent_guides": {
      "show": "never",
    },
    "default_width": 250,
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_name": false,
    "show_onboarding_banner": false,
    "show_project_items": false,
  },
  "toolbar": {
    "code_actions": false,
    "breadcrumbs": true,
  },
  "file_finder": {
    "modal_max_width": "small",
    "file_icons": true,
  },
  "debugger": {
    "dock": "right",
  },
  // Terminal
  "terminal": {
    "copy_on_select": true,
    "dock": "bottom",
    "button": true,
    "font_size": 12.0,
    "font_family": "CaskaydiaCove Nerd Font Mono",
    "cursor_shape": "underline",
    "blinking": "off",
  },

  // Git
  "git": {
    "git_gutter": "hide",
    "inline_blame": {
      "enabled": true,
    },
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
    "status_style": "icon",
  },
  // LSP & Intelligence

  "show_signature_help_after_edits": true,
  "auto_signature_help": false,
  "prettier": {
    "allowed": true,
  },
  "lsp": {
    "lua-language-server": {
      "settings": {
        "Lua": {
          "diagnostics": {
            "globals": ["hl"],
          },
          "workspace": {
            "library": ["/usr/share/hypr/stubs"],
            "checkThirdParty": false,
          },
        },
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "languages": {
    "QML": {
      "formatter": {
        "external": {
          "command": "sh",
          "arguments": ["-c", "tmp=$(mktemp --suffix .qml); cat > $tmp; qmlformat $tmp"],
        },
      },
    },
  },
}
