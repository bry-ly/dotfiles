# ---------------------------------------------------------------------------
# Build / runtime noise
# ---------------------------------------------------------------------------
node_modules/
.next/
dist/
build/
target/
.rust_cache/
.ruff_cache/
.dart_tool/
*.log
*.lock
!pnpm-lock.yaml
!bun.lock
!lazyvim.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local tooling caches inside tracked config dirs
**/.ruff_cache/
**/__pycache__/
**/*.pyc
**/Cache/
**/CachedData/
**/GPUCache/
**/Code Cache/
**/SingletonLock
**/SingletonSocket
**/SingletonCookie

# ---------------------------------------------------------------------------
# Submodules are tracked as gitlinks; ignore any nested build output
# ---------------------------------------------------------------------------
submodules/quickshell-git/quickshell/
submodules/quickshell-git/src/quickshell/

# Large binaries pulled in by theme/icon repos
themes/gtk/MacTahoe/
themes/icons/MacTahoe/